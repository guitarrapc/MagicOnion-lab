<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- dotnet-moc not support ManagePackageVersionsCentrally, therefore disable on Shared project.-->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MagicOnion.Abstractions" Version="7.11.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="MessagePack.UnityShims" Version="3.1.12" />
  </ItemGroup>

</Project>
